# ============================================
# Development Dockerfile for Next.js
# ============================================

FROM node:26.5.1-slim AS dev

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci --no-audit --no-fund

COPY . .

ENV WATCHPACK_POLLING=true
ENV HOSTNAME="0.0.0.0"

RUN chown -R node:node /app
USER node

EXPOSE 3000

CMD ["npm", "run", "dev"]