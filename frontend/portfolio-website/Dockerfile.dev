# ============================================
# Development Dockerfile for Next.js
# ============================================

FROM dhi.io/node:26.12.1-alpine3.24-dev AS dev

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci --no-audit --no-fund

COPY . . 

ENV HOSTNAME="0.0.0.0"

EXPOSE 3000

CMD ["npm", "run", "dev"]